{
    "$schema": "./node_modules/@angular/service-worker/config/schema.json",
    "index": "/index.html",
    "assetGroups": [
        {
            "name": "app-shell",
            "installMode": "prefetch",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/index.html",
                    "/*.css",
                    "/*.js",
                    "/manifest.webmanifest"
                ]
            }
        },
        {
            "name": "static-assets",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/**/*.svg",
                    "/**/*.png",
                    "/**/*.jpg",
                    "/**/*.jpeg",
                    "/**/*.ico",
                    "/**/*.woff",
                    "/**/*.woff2"
                ]
            }
        }
    ],
    "dataGroups": [
        {
            "name": "api-backend",
            "urls": [
                "https://encuestas-back-production.up.railway.app/**",
                "http://localhost:8080/**"
            ],
            "cacheConfig": {
                "strategy": "network-first",
                "maxAge": "0h",
                "maxSize": 0
            }
        }
    ],
    "navigationUrls": [
        "/**",
        "!/**/*.{js,css,png,gif,svg,jpg,jpeg,ico,woff,woff2}"
    ]
}
